rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 2. Validation Blueprints (Verbatim from firebase-blueprint.json)
    function isValidUserWorkspace(data) {
      return data.keys().hasAll([
        'ownerId',
        'displayName',
        'pomodoroSessions',
        'pomodoroMinutes',
        'resumeFullName',
        'resumeTitle',
        'resumeSummary',
        'resumeEducation',
        'resumeExperience',
        'resumeProjects',
        'resumeSkillsText',
        'resumeColor',
        'savedNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'displayName',
        'pomodoroSessions',
        'pomodoroMinutes',
        'resumeFullName',
        'resumeTitle',
        'resumeSummary',
        'resumeEducation',
        'resumeExperience',
        'resumeProjects',
        'resumeSkillsText',
        'resumeColor',
        'savedNotes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.pomodoroSessions is number && data.pomodoroSessions >= 0 && data.pomodoroSessions <= 100000 &&
      data.pomodoroMinutes is number && data.pomodoroMinutes >= 0 && data.pomodoroMinutes <= 5000000 &&
      data.resumeFullName is string && data.resumeFullName.size() >= 0 && data.resumeFullName.size() <= 120 &&
      data.resumeTitle is string && data.resumeTitle.size() >= 0 && data.resumeTitle.size() <= 120 &&
      data.resumeSummary is string && data.resumeSummary.size() >= 0 && data.resumeSummary.size() <= 2000 &&
      data.resumeEducation is string && data.resumeEducation.size() >= 0 && data.resumeEducation.size() <= 2000 &&
      data.resumeExperience is string && data.resumeExperience.size() >= 0 && data.resumeExperience.size() <= 3000 &&
      data.resumeProjects is string && data.resumeProjects.size() >= 0 && data.resumeProjects.size() <= 3000 &&
      data.resumeSkillsText is string && data.resumeSkillsText.size() >= 0 && data.resumeSkillsText.size() <= 1000 &&
      data.resumeColor is string && data.resumeColor.size() >= 4 && data.resumeColor.size() <= 20 &&
      data.savedNotes is string && data.savedNotes.size() >= 0 && data.savedNotes.size() <= 5000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSavedCalculation(data) {
      return data.keys().hasAll([
        'ownerId',
        'toolName',
        'summary',
        'details',
        'category',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'toolName',
        'summary',
        'details',
        'category',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.toolName is string && data.toolName.size() >= 1 && data.toolName.size() <= 80 &&
      data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
      data.details is string && data.details.size() >= 0 && data.details.size() <= 2000 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
      data.category in ['academic', 'finance', 'utility', 'ai_note'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 1: /userWorkspaces/{userId}
    match /userWorkspaces/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserWorkspace(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isVerifiedUser() &&
        isValidUserWorkspace(incoming()) &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Sync Workspace / Resume / Notes / Pomodoro
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'pomodoroSessions',
            'pomodoroMinutes',
            'resumeFullName',
            'resumeTitle',
            'resumeSummary',
            'resumeEducation',
            'resumeExperience',
            'resumeProjects',
            'resumeSkillsText',
            'resumeColor',
            'savedNotes',
            'updatedAt'
          ])) ||
          // Action 2: Quick Pomodoro Increment
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'pomodoroSessions',
            'pomodoroMinutes',
            'updatedAt'
          ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        existing().ownerId == request.auth.uid;
    }

    // Collection 2: /savedCalculations/{calcId}
    match /savedCalculations/{calcId} {
      allow get: if isSignedIn() && isValidId(calcId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(calcId) &&
        isValidSavedCalculation(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/userWorkspaces/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userWorkspaces/$(request.auth.uid)).data.ownerId == request.auth.uid;

      allow update: if (
        isVerifiedUser() &&
        isValidSavedCalculation(incoming()) &&
        isValidId(calcId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Update Saved Calculation or Note Content
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'toolName',
            'summary',
            'details',
            'category',
            'updatedAt'
          ]))
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(calcId) &&
        existing().ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/userWorkspaces/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userWorkspaces/$(request.auth.uid)).data.ownerId == request.auth.uid;
    }
  }
}
